@model YourProjectName.Models.JobViewModel

@{
    ViewData["Title"] = "สำหรับช่าง";
}

<div class="main-content-container">
    <div class="container py-4">
        
        <div class="content-wrapper mb-3">
            <div class="header-box">
                <h4 class="title-text">งาน</h4>
            </div>
        </div>

        <div class="content-wrapper">
            <div class="job-card">
                <div class="job-body">
                    <div class="job-info-section">
                        <div class="profile-placeholder"></div>
                        
                        <div class="details">
                            <h5 class="customer-name">@Model.CustomerName</h5>
                            <p class="phone-text">เบอร์โทร : @Model.PhoneNumber</p>
                            <button class="btn btn-detail">รายละเอียด</button>
                        </div>
                    </div>

                    <div class="action-section">
                        <button class="btn btn-accept">รับงาน</button>
                        <button class="btn btn-reject">ปฏิเสธ</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<footer class="footer-bottom">
    <p>© 2024 Changonline. All rights reserved.</p>
</footer>