@{
    ViewData["Title"] = "การเรียกใช้บริการของฉัน";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f2f2f2;
        font-family: "Segoe UI", sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .main-card {
        background: white;
        padding: 25px;
        margin: 40px;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        flex: 1;
    }

    .section-title {
        background: #eef2f7;
        padding: 15px 25px;
        font-size: 20px;
        font-weight: bold;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .service-box {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .profile-placeholder {
        width: 90px;
        height: 90px;
        background: #d9d9d9;
        border-radius: 5px;
        margin-right: 20px;
    }

    .btn-detail {
        border: 1px solid #b82a2c;
        color: #b82a2c;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-cancel {
        border: 1px solid #2a6db8;
        color: #2a6db8;
        border-radius: 10px;
        padding: 6px 20px;
    }

    footer {
        text-align: center;
        padding: 20px;
        color: #555;
        margin-top: 40px;
    }
</style>

<div class="main-card">
    <div class="section-title">การเรียกใช้บริการของฉัน</div>

    <!-- 🔹 SERVICE ITEM 1 -->
    <div class="service-box">
        <div class="profile-placeholder"></div>

        <div class="service-info col-8">
            <p><strong>นาย สมชาย ใจดี</strong></p>
            <p>เบอร์โทร : 013-113-1130</p>
            <p>สถานะ : <span class="fw-bold text-primary">กำลังเดินทาง</span></p>
        </div>

        <div class="text-end col">
            <button class="btn btn-detail" data-bs-toggle="modal" data-bs-target="#detailModal">
                รายละเอียด
            </button><br />
            <button class="btn btn-cancel" onclick="cancelService(this)">
                ยกเลิก
            </button>
        </div>
    </div>

    <!-- 🔹 SERVICE ITEM 2 -->
    <div class="service-box">
        <div class="profile-placeholder"></div>

        <div class="service-info col-8">
            <p><strong>นาง สมหญิง แสนดี</strong></p>
            <p>เบอร์โทร : 099-888-7777</p>
            <p>สถานะ : <span class="fw-bold text-warning">รอยืนยัน</span></p>
        </div>

        <div class="text-end col">
            <button class="btn btn-detail" data-bs-toggle="modal" data-bs-target="#detailModal">
                รายละเอียด
            </button><br />
            <button class="btn btn-cancel" onclick="cancelService(this)">
                ยกเลิก
            </button>
        </div>
    </div>

    <!-- 🔹 SERVICE ITEM 3 -->
    <div class="service-box">
        <div class="profile-placeholder"></div>

        <div class="service-info col-8">
            <p><strong>นาย ช่างเอก มือทอง</strong></p>
            <p>เบอร์โทร : 081-222-3333</p>
            <p>สถานะ : <span class="fw-bold text-success">เสร็จสิ้น</span></p>
        </div>

        <div class="text-end col">
            <button class="btn btn-detail" data-bs-toggle="modal" data-bs-target="#detailModal">
                รายละเอียด
            </button><br />
            <button class="btn btn-cancel" onclick="cancelService(this)">
                ยกเลิก
            </button>
        </div>
    </div>
</div>

<footer>
© 2024 Changonline. All rights reserved.
</footer>

<!-- 🔹 DETAIL MODAL -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">รายละเอียดการเรียกใช้บริการ</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>ชื่อผู้ให้บริการ:</strong> ตัวอย่างชื่อ</p>
                <p><strong>เบอร์โทร:</strong> ตัวอย่างเบอร์</p>
                <p><strong>สถานะ:</strong> ตัวอย่างสถานะ</p>
                <hr />
                <p><strong>ประเภทงาน:</strong> ซ่อมแอร์บ้าน</p>
                <p><strong>รายละเอียดงาน:</strong> ตรวจเช็ค → ซ่อม → ทำความสะอาด</p>
                <p><strong>เวลาที่เรียกใช้:</strong> 10 ธ.ค. 2024 เวลา 12:30 น.</p>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
            </div>

        </div>
    </div>
</div>

<script>
    function cancelService(btn) {
        if (confirm("ยืนยันยกเลิกการเรียกใช้บริการ?")) {
            btn.closest(".service-box").remove();
        }
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
