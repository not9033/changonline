@model IEnumerable<ChangOnline.Models.AppUser>
@{
    ViewData["Title"] = "จัดการผู้ใช้";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
}
<h2>@ViewData["Title"]</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ชื่อ</th>
            <th>Email</th>
            <th>เบอร์โทร</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var u in Model)
        {
            <tr>
                <td>@u.FirstName @u.LastName</td>
                <td>@u.Email</td>
                <td>@u.PhoneNumber</td>
                <td>
                    <a href="/Admin/UserProfile/@u.Id" class="btn btn-info btn-sm me-1">ดูโปรไฟล์</a>
                    <a href="/Admin/DeleteUser/@u.Id" class="btn btn-danger btn-sm">ลบ</a>
                </td>
            </tr>
        }
    </tbody>
</table>
