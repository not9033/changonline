@model ChangOnline.Models.Admin.TechnicianModel

@{
    ViewData["Title"] = "โปรไฟล์ช่าง";
}

<h2>@ViewData["Title"]</h2>

<div class="card mb-3" style="max-width: 600px;">
    <div class="card-body">
        <h4>@Model.Name</h4>
        <p><strong>ทักษะ:</strong> @Model.Skill</p>
        <p><strong>เบอร์โทร:</strong> @Model.Phone</p>
        <p><strong>สถานะ:</strong> @Model.Status</p>
    </div>
</div>

<a class="btn btn-secondary" href="/Admin/Technicians"><i class="bi bi-arrow-left"></i> กลับไปหน้าช่าง</a>
