@model ChangOnline.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">ผู้ใช้ทั้งหมด</h5>
                <p class="card-text display-6">@Model.TotalUsers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">ช่างทั้งหมด</h5>
                <p class="card-text display-6">@Model.TotalTechnicians</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <h5 class="card-title">รออนุมัติ</h5>
                <p class="card-text display-6">@Model.PendingTechnicians</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <h5 class="card-title">งานวันนี้</h5>
                <p class="card-text display-6">@Model.JobsToday</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <a class="btn btn-primary me-2" href="/Admin/Users"><i class="bi bi-people"></i> จัดการผู้ใช้</a>
    <a class="btn btn-success" href="/Admin/Technicians"><i class="bi bi-wrench"></i> จัดการช่าง</a>
</div>

<h3>รายการงานล่าสุด</h3>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ผู้เรียก</th>
            <th>ช่าง</th>
            <th>ประเภทงาน</th>
            <th>เวลาเรียก</th>
            <th>สถานะ</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var job in Model.RecentJobs)
        {
            <tr>
                <td>@job.UserName</td>
                <td>@(string.IsNullOrEmpty(job.TechnicianName) ? "-" : job.TechnicianName)</td>
                <td>@job.Type</td>
                <td>@job.Date.ToString("g")</td>
                <td>@job.Status</td>
            </tr>
        }
    </tbody>
</table>
