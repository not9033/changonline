@model IEnumerable<ChangOnline.Models.Admin.TechnicianModel>
@{
    ViewData["Title"] = "จัดการช่าง";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
}
<h2>@ViewData["Title"]</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ชื่อ</th>
            <th>ทักษะ</th>
            <th>สถานะ</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.Skill</td>
                <td>@t.Status</td>
                <td>
                    <a href="/Admin/TechnicianProfile/@t.Id" class="btn btn-info btn-sm me-1">ดู</a>
                    @if(t.Status=="Pending")
                    {
                        <a href="/Admin/ApproveTechnician/@t.Id" class="btn btn-success btn-sm me-1">อนุมัติ</a>
                    }
                    <a href="/Admin/DeleteTechnician/@t.Id" class="btn btn-danger btn-sm">ลบ</a>
                </td>
            </tr>
        }
    </tbody>
</table>
