@model ChangOnline.Models.ProviderProfile

@{
    ViewData["Title"] = "Provider Info";
}

<style>
    body {
        background: #f5f7fb;
    }

    .provider-info-container {
        display: flex;
        justify-content: center;
        margin: 50px 0;
        padding: 0 20px;
    }

    .provider-detail-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        padding: 40px 45px;
        width: 100%;
        max-width: 1000px;
    }

    /* ---------- section header + button ---------- */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #3b6cb7;
    }

    .request-btn {
        background: linear-gradient(90deg, #4f8cff, #ff5c5c);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 8px 22px;
        font-size: 14px;
        cursor: pointer;
    }

    .provider-header {
        display: flex;
        gap: 40px;
        margin-bottom: 35px;
    }

    .provider-image {
        width: 150px;
        height: 150px;
        background: #e0e0e0;
        border-radius: 12px;
        object-fit: cover;
    }

    .provider-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 30px;
        width: 100%;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 999px;
        border: 2px solid transparent;
        background:
            linear-gradient(#fff, #fff) padding-box,
            linear-gradient(90deg, #4f8cff, #ff5c5c) border-box;
        padding: 8px 16px;
        font-size: 14px;
        height: 40px;
    }

    .full-width {
        grid-column: span 2;
    }

    .category-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .category-tag {
        background: #eef2ff;
        color: #3b5bcc;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 13px;
    }

    /* ---------- textarea ให้พอเหมาะ ---------- */
    textarea.form-control {
        border-radius: 14px;
        height: 140px; /* 👈 ลดขนาด */
        resize: none;
        padding: 14px 16px;
        line-height: 1.6;
    }
</style>


<div class="provider-info-container">
    <div class="provider-detail-card">

        <!-- header + button -->
        <div class="section-header">
            <div class="section-title">ข้อมูลช่าง</div>
            <button class="request-btn">ขอรับบริการ</button>
        </div>

        <div class="provider-header">
            <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/image/man.png" : Model.ImagePath)" class="provider-image"/>

            <div class="provider-form">

                <div class="form-group">
                    <label>ชื่อ</label>
                    <input class="form-control" value="@Model.User?.FirstName" readonly/>
                </div>

                <div class="form-group">
                    <label>นามสกุล</label>
                    <input class="form-control" value="@Model.User?.LastName" readonly/>
                </div>

                <div class="form-group full-width">
                    <label>ที่อยู่</label>
                    <input class="form-control" value="@Model.Address" readonly/>
                </div>

                <div class="form-group">
                    <label>ตำบล</label>
                    <input class="form-control" value="@Model.Subdistrict?.name_th" readonly/>
                </div>

                <div class="form-group">
                    <label>อำเภอ</label>
                    <input class="form-control" value="@Model.District?.NameTh" readonly/>
                </div>

                <div class="form-group">
                    <label>จังหวัด</label>
                    <input class="form-control" value="@Model.Province?.NameTh" readonly/>
                </div>

                <div class="form-group">
                    <label>เบอร์โทร</label>
                    <input class="form-control" value="@Model.User?.PhoneNumber" readonly/>
                </div>

                @* <div class="form-group full-width">
                    <label>ประเภทงาน</label>
                    <input class="form-control" value="@Model.Service" readonly/>
                </div> *@

                <!-- คงหมวดหมู่เดิม -->
                <div class="form-group full-width">
                    <label>หมวดหมู่งานที่รับ</label>
                    <div class="category-tags">
                        @foreach (var cat in Model.Categories)
                        {
                            <span class="category-tag">@cat.Name</span>
                        }
                        @if (!Model.Categories.Any())
                        {
                            <span class="category-tag">ไม่ระบุ</span>
                        }
                    </div>
                </div>

            </div>
        </div>

        <div class="section-title">รายละเอียดและอัตราค่าบริการ</div>

        <textarea class="form-control" readonly>@(string.IsNullOrEmpty(Model.Service) ? "ยังไม่มีรายละเอียดเพิ่มเติม" : Model.Service)</textarea>

    </div>
</div>


