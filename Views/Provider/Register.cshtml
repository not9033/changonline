@model ChangOnline.Models.ViewModels.ProviderRegisterViewModel

@{
    ViewData["Title"] = "Register as Provider";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">สมัครเป็นช่าง</h3>
                </div>
                <div class="card-body">
                    <p>กรุณากรอกข้อมูลเพื่อสมัครเป็นช่างในระบบ</p>
                    <form asp-action="Register" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Image Upload Section -->
                        <div class="mb-4 text-center">
                            <div class="mb-3">
                                <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.CurrentImagePath) ? "/image/man.png" : Model.CurrentImagePath)"
                                     alt="Profile Image"
                                     style="width: 150px; height: 150px; object-fit: cover; border-radius: 12px; border: 2px solid #ddd;">
                            </div>
                            <input type="file" id="profileImageInput" name="ProfileImage" accept="image/*" style="display: none;">
                            <button type="button" class="btn btn-primary btn-sm me-2" onclick="document.getElementById('profileImageInput').click()">
                                <i class="fas fa-upload"></i> เปลี่ยนรูปภาพ
                            </button>
                            @if (!string.IsNullOrEmpty(Model.CurrentImagePath) && Model.CurrentImagePath != "/image/man.png")
                            {
                                <button type="button" class="btn btn-danger btn-sm" id="deleteImageBtn">
                                    <i class="fas fa-trash"></i> ลบรูปภาพ
                                </button>
                            }
                            <span asp-validation-for="ProfileImage" class="text-danger d-block mt-2"></span>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Service" class="form-label"></label>
                            <input asp-for="Service" class="form-control"/>
                            <span asp-validation-for="Service" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">หมวดหมู่งานช่าง</label>
                            <div>
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#categoryModal">
                                    เลือกหมวดหมู่
                                </button>
                            </div>
                            <!-- Display selected categories here -->
                            <div id="selectedCategoriesDisplay" class="mt-2">
                                <!-- Note: For Register, we might not have Names initially if validation fails, unless we repopulate them. 
                                But we can try to populate from selected checkboxes on load if needed, or just rely on user re-selecting.
                                For simplicity, we leave it empty initially or populate via JS on load if we want to be fancy. -->
                            </div>
                            <!-- Hidden inputs for form submission -->
                            <div id="hiddenCategoryInputs">
                                @if (Model.SelectedCategoryIds != null)
                                {
                                    foreach (var id in Model.SelectedCategoryIds)
                                    {
                                        <input type="hidden" name="SelectedCategoryIds" value="@id"/>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Modal -->
                        <div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="categoryModalLabel">เลือกหมวดหมู่งานช่าง</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="text" id="categorySearchInput" class="form-control mb-3" placeholder="ค้นหาหมวดหมู่...">
                                        <div class="row" id="categoryList">
                                            @if (Model.Categories != null)
                                            {
                                                foreach (var category in Model.Categories)
                                                {
                                                    <div class="col-md-2 category-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input category-checkbox" type="checkbox" value="@category.Value" data-name="@category.Text" id="modal_cat_@category.Value"
                                                                   @(Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(int.Parse(category.Value)) ? "checked" : "")>
                                                            <label class="form-check-label" for="modal_cat_@category.Value">
                                                                @category.Text
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                                        <button type="button" class="btn btn-primary" id="saveCategoriesBtn">ยืนยัน</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ProvinceId" class="form-label"></label>
                                <select asp-for="ProvinceId" asp-items="Model.Provinces" class="form-select" id="provinceSelect">
                                    <option value="">-- เลือกจังหวัด --</option>
                                </select>
                                <span asp-validation-for="ProvinceId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="DistrictId" class="form-label"></label>
                                <select asp-for="DistrictId" asp-items="Model.Districts" class="form-select" id="districtSelect">
                                    <option value="">-- เลือกอำเภอ --</option>
                                </select>
                                <span asp-validation-for="DistrictId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="SubdistrictId" class="form-label"></label>
                                <select asp-for="SubdistrictId" asp-items="Model.Subdistricts" class="form-select" id="subdistrictSelect">
                                    <option value="">-- เลือกตำบล --</option>
                                </select>
                                <span asp-validation-for="SubdistrictId" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">สมัคร</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(document).ready(function () {
            $('#provinceSelect').change(function () {
                var provinceId = $(this).val();
                $('#districtSelect').empty().append('<option value="">-- เลือกอำเภอ --</option>');
                $('#subdistrictSelect').empty().append('<option value="">-- เลือกตำบล --</option>');

                if (provinceId) {
                    $.getJSON('@Url.Action("GetDistricts", "Provider")', { provinceId: provinceId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#districtSelect').append($('<option>').text(item.name).val(item.id));
                        });
                    });
                }
            });

            $('#districtSelect').change(function () {
                var districtId = $(this).val();
                $('#subdistrictSelect').empty().append('<option value="">-- เลือกตำบล --</option>');

                if (districtId) {
                    $.getJSON('@Url.Action("GetSubdistricts", "Provider")', { districtId: districtId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#subdistrictSelect').append($('<option>').text(item.name).val(item.id));
                        });
                    });
                }
            });

            // Category Modal Scripts
            $('#categorySearchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#categoryList .category-item').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            $('#saveCategoriesBtn').click(function() {
                var selectedIds = [];
                var selectedNames = [];
                
                $('.category-checkbox:checked').each(function() {
                    selectedIds.push($(this).val());
                    selectedNames.push($(this).data('name'));
                });

                // Update display
                var displayHtml = '';
                selectedNames.forEach(function(name) {
                    displayHtml += '<span class="badge bg-info text-dark me-1">' + name + '</span>';
                });
                $('#selectedCategoriesDisplay').html(displayHtml);

                // Update hidden inputs
                var inputsHtml = '';
                selectedIds.forEach(function(id) {
                    inputsHtml += '<input type="hidden" name="SelectedCategoryIds" value="' + id + '" />';
                });
                $('#hiddenCategoryInputs').html(inputsHtml);

                // Close modal
                $('#categoryModal').modal('hide');
            });

            // Trigger save on load to populate display if there are pre-selected items (e.g. validation error)
            if ($('.category-checkbox:checked').length > 0) {
                 $('#saveCategoriesBtn').click();
            }

            // Image preview functionality
            $('#profileImageInput').change(function(e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').attr('src', e.target.result);
                    }
                    reader.readAsDataURL(file);
                }
            });

            // Delete image functionality
            $('#deleteImageBtn').click(function() {
                if (confirm('คุณต้องการลบรูปภาพนี้หรือไม่?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteImage", "Provider")',
                        type: 'POST',
                        success: function(response) {
                            if (response.success) {
                                $('#imagePreview').attr('src', '/image/man.png');
                                $('#deleteImageBtn').hide();
                                alert(response.message);
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function() {
                            alert('เกิดข้อผิดพลาดในการลบรูปภาพ');
                        }
                    });
                }
            });
        });
    </script>
}
