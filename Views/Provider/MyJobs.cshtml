@model IEnumerable<ChangOnline.Models.ServiceRequest>

@{
    ViewData["Title"] = "งานของฉัน";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>

<style>
    body {
        background-color: #f2f2f2;
        font-family: "Segoe UI", sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .main-card {
        background: white;
        padding: 25px;
        margin: 40px;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        flex: 1;
    }

    .section-title {
        background: #eef2f7;
        padding: 15px 25px;
        font-size: 20px;
        font-weight: bold;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .service-box {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        border: 1px solid #e0e0e0;
    }

    .profile-placeholder {
        width: 90px;
        height: 90px;
        background: #d9d9d9;
        border-radius: 50%;
        margin-right: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        color: #666;
    }

    .btn-accept {
        background-color: #4caf50;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-accept:hover {
        background-color: #45a049;
        color: white;
    }

    .btn-reject {
        background-color: #f44336;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-reject:hover {
        background-color: #da190b;
        color: white;
    }

    .btn-complete {
        background-color: #2196F3;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-complete:hover {
        background-color: #0b7dda;
        color: white;
    }

    .btn-detail {
        border: 1px solid #b82a2c;
        color: #b82a2c;
        background: white;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-detail:hover {
        background-color: #b82a2c;
        color: white;
    }

    footer {
        text-align: center;
        padding: 20px;
        color: #555;
        margin-top: 40px;
    }

    .no-requests {
        text-align: center;
        padding: 40px;
        color: #999;
        font-size: 16px;
    }

    .status-pending { color: #ff9800; font-weight: bold; }
    .status-accepted { color: #204c9e; font-weight: bold; }
    .status-rejected { color: #f44336; font-weight: bold; }
    .status-completed { color: #4caf50; font-weight: bold; }
    .status-cancelled { color: #9e9e9e; font-weight: bold; }

    .info-label {
        font-weight: 600;
        color: #555;
    }
</style>


<div class="main-card">

    <div class="section-title">งานของฉัน</div>

    @if (Model != null && Model.Any())
    {
        @foreach (var request in Model)
        {
            var statusText = request.Status switch
            {
                ChangOnline.Models.ServiceRequestStatus.Pending => "รอการตอบรับ",
                ChangOnline.Models.ServiceRequestStatus.Accepted => "ได้รับการตอบรับ",
                ChangOnline.Models.ServiceRequestStatus.Rejected => "ถูกปฏิเสธ",
                ChangOnline.Models.ServiceRequestStatus.Completed => "เสร็จสิ้น",
                ChangOnline.Models.ServiceRequestStatus.Cancelled => "ยกเลิกแล้ว",
                _ => "ไม่ทราบสถานะ"
            };

            var statusClass = request.Status switch
            {
                ChangOnline.Models.ServiceRequestStatus.Pending => "status-pending",
                ChangOnline.Models.ServiceRequestStatus.Accepted => "status-accepted",
                ChangOnline.Models.ServiceRequestStatus.Rejected => "status-rejected",
                ChangOnline.Models.ServiceRequestStatus.Completed => "status-completed",
                ChangOnline.Models.ServiceRequestStatus.Cancelled => "status-cancelled",
                _ => ""
            };

            <div class="service-box"
                 data-request-id="@request.Id"
                 data-requester-name="@(request.Requester?.FirstName ?? "ไม่ระบุ") @(request.Requester?.LastName ?? "")"
                 data-requester-phone="@(request.Requester?.PhoneNumber ?? "")"
                 data-requester-image="@(request.Requester?.ImagePath ?? "/image/man.png")"
                 data-appointment="@request.AppointmentDate.ToString("dd/MM/yyyy HH:mm")"
                 data-address="@request.Address, @request.Subdistrict, @request.District, @request.Province"
                 data-contact="@request.ContactNumber"
                 data-job-details="@(request.JobDetails ?? "")"
                 data-remarks="@(request.Remarks ?? "")"
                 data-status="@request.Status"
                 data-status-text="@statusText"
                 data-status-color="@(request.Status == ChangOnline.Models.ServiceRequestStatus.Pending ? "#ff9800" :
                                    request.Status == ChangOnline.Models.ServiceRequestStatus.Accepted ? "#204c9e" :
                                    request.Status == ChangOnline.Models.ServiceRequestStatus.Rejected ? "#f44336" :
                                    request.Status == ChangOnline.Models.ServiceRequestStatus.Completed ? "#4caf50" : "#9e9e9e")">

                @{
                    var requesterImage = !string.IsNullOrEmpty(request.Requester?.ImagePath)
                        ? request.Requester.ImagePath
                        : "/image/man.png";
                }
                <img src="@requesterImage" alt="Requester"
                     style="width: 90px; height: 90px; border-radius: 50%; object-fit: cover; margin-right: 20px;">

                <div class="service-info col-7">
                    <p>
                        <span class="info-label">ลูกค้า:</span>
                        <strong>@(request.Requester?.FirstName ?? "ไม่ระบุ") @(request.Requester?.LastName ?? "")</strong>
                    </p>
                    <p>
                        <span class="info-label">เบอร์โทร:</span> @(request.ContactNumber ?? "ไม่ระบุ")
                    </p>
                    <p>
                        <span class="info-label">วันนัดหมาย:</span> @request.AppointmentDate.ToString("dd/MM/yyyy HH:mm")
                    </p>
                    <p><span class="info-label">สถานที่:</span> @request.Address, @request.Subdistrict, @request.District, @request.Province</p>
                    @if (!string.IsNullOrEmpty(request.JobDetails))
                    {
                        <p>
                            <span class="info-label">รายละเอียดงาน:</span> @request.JobDetails
                        </p>
                    }
                    <p>
                        <span class="info-label">สถานะ:</span> <span class="@statusClass">@statusText</span>
                    </p>
                </div>

                <div class="text-end col">
                    @if (request.Status == ChangOnline.Models.ServiceRequestStatus.Pending)
                    {
                        <button class="btn btn-accept" onclick="updateStatus(@request.Id, 'accepted')">ตอบรับ</button>
                        <br/>
                        <button class="btn btn-reject" onclick="updateStatus(@request.Id, 'rejected')">ปฏิเสธ</button>
                        <br/>
                    }
                    else if (request.Status == ChangOnline.Models.ServiceRequestStatus.Accepted)
                    {
                        <button class="btn btn-complete" onclick="updateStatus(@request.Id, 'completed')">เสร็จสิ้น</button>
                        <br/>
                    }
                    <button class="btn btn-detail" onclick="showDetails(@request.Id)">รายละเอียด</button>
                </div>

            </div>
        }
    }
    else
    {
        <div class="no-requests">
            <p>ยังไม่มีงานที่ได้รับมอบหมาย</p>
        </div>
    }

</div>

<!-- Detail Modal -->
<div id="detailModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
    <div style="background-color: white; margin: 5% auto; padding: 0; width: 90%; max-width: 600px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
        <div style="padding: 20px 25px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">
            <h5 style="margin: 0; font-size: 20px; font-weight: 600;">รายละเอียดงาน</h5>
            <button onclick="closeDetailModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">&times;</button>
        </div>
        <div id="modalContent" style="padding: 25px; max-height: 70vh; overflow-y: auto;">
            <!-- Content will be populated by JavaScript -->
        </div>
    </div>
</div>
<script src="~/js/myjobs.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script>
</script>
