@model ChangOnline.Models.ProviderProfile

@{
  ViewData["Title"] = "สำหรับช่าง";
}

<div class="main-container">
  <div class="sidebar">

    <div class="sidebar-content">
      <div class="sidebar-item">
        <a href="">ข้อมูลส่วนตัว</a>
      </div>
      <div class="sidebar-item">
        <a href="@Url.Action("MyJobs", "Provider")">งานของฉัน</a>
      </div>
      <div class="sidebar-item">
        <form method="post" action="@Url.Action("Logout", "Account")" style="margin: 0;">
          <button type="submit" style="background: none; border: none; color: #333; cursor: pointer; width: 100%; text-align: center; padding: 0; font-size: 16px;">
            ออกจากระบบ
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="profile-card">
      <h2 class="profile-title">ข้อมูลส่วนตัว</h2>

      <!-- Profile Image Section -->
      <div class="profile-image-section">
        @{
          var displayImage = !string.IsNullOrEmpty(Model.ImagePath)
            ? Model.ImagePath
            : "/image/man.png";
        }
        <img src="@displayImage" alt="Profile" class="profile-image">
        <div class="profile-name">
          <h3>@Model.User.FirstName @Model.User.LastName</h3>
          <p class="text-muted">@Model.User.Email</p>
        </div>
      </div>

      <!-- Profile Details -->
      <div class="profile-details">
        <div class="detail-row">
          <span class="detail-label">เบอร์โทร:</span>
          <span class="detail-value">@Model.User.PhoneNumber</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">บริการ:</span>
          <span class="detail-value">@Model.Service</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">หมวดหมู่:</span>
          <span class="detail-value">
            @if (Model.Categories != null && Model.Categories.Any())
            {
              @string.Join(", ", Model.Categories.Select(c => c.Name))
            }
            else
            {
              <span class="text-muted">-</span>
            }
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">ที่อยู่ร้าน:</span>
          <span class="detail-value">
            @Model.Address
            @if (Model.Subdistrict != null)
            {
              <text>, @Model.Subdistrict.name_th</text>
            }
            @if (Model.District != null)
            {
              <text>, @Model.District.NameTh</text>
            }
            @if (Model.Province != null)
            {
              <text>, @Model.Province.NameTh</text>
            }
          </span>
        </div>
      </div>

      <!-- Edit Button -->
      <div class="profile-actions">
        <a href="@Url.Action("Register", "Provider")" class="btn-edit">
          <i class="bi bi-pencil"></i> แก้ไขข้อมูล
        </a>
      </div>
    </div>
  </div>

</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">