@model ChangOnline.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
}

<div class="container mt-5" style="margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">Edit Profile</h3>
                </div>
                <div class="card-body">
                    <form asp-action="EditProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label"></label>
                            <input asp-for="UserName" class="form-control" disabled/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" disabled/>
                        </div>

                        <h5 class="mt-4 mb-3">Personal Information</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control"/>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control"/>
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control"/>
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ProvinceId" class="form-label"></label>
                                <select asp-for="ProvinceId" asp-items="Model.Provinces" class="form-select" id="provinceSelect">
                                    <option value="">-- Select Province --</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="DistrictId" class="form-label"></label>
                                <select asp-for="DistrictId" asp-items="Model.Districts" class="form-select" id="districtSelect">
                                    <option value="">-- Select District --</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="SubdistrictId" class="form-label"></label>
                                <select asp-for="SubdistrictId" asp-items="Model.Subdistricts" class="form-select" id="subdistrictSelect">
                                    <option value="">-- Select Subdistrict --</option>
                                </select>
                            </div>
                        </div>

                        @if (Model.IsProvider)
                        {
                            <hr/>
                            <h5 class="mt-4 mb-3 text-primary">Provider Information</h5>

                            <div class="mb-3">
                                <label asp-for="ProviderService" class="form-label"></label>
                                <input asp-for="ProviderService" class="form-control"/>
                                <span asp-validation-for="ProviderService" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">หมวดหมู่งานช่าง</label>
                                <div>
                                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#categoryModal">
                                        เลือกหมวดหมู่
                                    </button>
                                </div>
                                <!-- Display selected categories here -->
                                <div id="selectedCategoriesDisplay" class="mt-2">
                                    @if (Model.ProviderCategoryNames != null)
                                    {
                                        foreach (var name in Model.ProviderCategoryNames)
                                        {
                                            <span class="badge bg-info text-dark me-1">@name</span>
                                        }
                                    }
                                </div>
                                <!-- Hidden inputs for form submission -->
                                <div id="hiddenCategoryInputs">
                                    @if (Model.ProviderCategoryIds != null)
                                    {
                                        foreach (var id in Model.ProviderCategoryIds)
                                        {
                                            <input type="hidden" name="ProviderCategoryIds" value="@id"/>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Modal -->
                            <div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="categoryModalLabel">เลือกหมวดหมู่งานช่าง</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="text" id="categorySearchInput" class="form-control mb-3" placeholder="ค้นหาหมวดหมู่...">
                                            <div class="row" id="categoryList">
                                                @if (Model.Categories != null)
                                                {
                                                    foreach (var category in Model.Categories)
                                                    {
                                                        <div class="col-md-2 category-item">
                                                            <div class="form-check">
                                                                <input class="form-check-input category-checkbox" type="checkbox" value="@category.Value" data-name="@category.Text" id="modal_cat_@category.Value"
                                                                       @(Model.ProviderCategoryIds != null && Model.ProviderCategoryIds.Contains(int.Parse(category.Value)) ? "checked" : "")>
                                                                <label class="form-check-label" for="modal_cat_@category.Value">
                                                                    @category.Text
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                                            <button type="button" class="btn btn-primary" id="saveCategoriesBtn">ยืนยัน</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ProviderAddress" class="form-label"></label>
                                <textarea asp-for="ProviderAddress" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="ProviderAddress" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ProviderProvinceId" class="form-label"></label>
                                    <select asp-for="ProviderProvinceId" asp-items="Model.Provinces" class="form-select" id="providerProvinceSelect">
                                        <option value="">-- Select Province --</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ProviderDistrictId" class="form-label"></label>
                                    <select asp-for="ProviderDistrictId" asp-items="Model.ProviderDistricts" class="form-select" id="providerDistrictSelect">
                                        <option value="">-- Select District --</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ProviderSubdistrictId" class="form-label"></label>
                                    <select asp-for="ProviderSubdistrictId" asp-items="Model.ProviderSubdistricts" class="form-select" id="providerSubdistrictSelect">
                                        <option value="">-- Select Subdistrict --</option>
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Profile" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(document).ready(function () {
            // User Address Scripts
            $('#provinceSelect').change(function () {
                var provinceId = $(this).val();
                $('#districtSelect').empty().append('<option value="">-- Select District --</option>');
                $('#subdistrictSelect').empty().append('<option value="">-- Select Subdistrict --</option>');

                if (provinceId) {
                    $.getJSON('@Url.Action("GetDistricts", "Account")', { provinceId: provinceId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#districtSelect').append($('<option>').text(item.name).val(item.id));
                        });
                    });
                }
            });

            $('#districtSelect').change(function () {
                var districtId = $(this).val();
                $('#subdistrictSelect').empty().append('<option value="">-- Select Subdistrict --</option>');

                if (districtId) {
                    $.getJSON('@Url.Action("GetSubdistricts", "Account")', { districtId: districtId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#subdistrictSelect').append($('<option>').text(item.name).val(item.id));
                        });
                    });
                }
            });

            // Provider Address Scripts
            $('#providerProvinceSelect').change(function () {
                var provinceId = $(this).val();
                $('#providerDistrictSelect').empty().append('<option value="">-- Select District --</option>');
                $('#providerSubdistrictSelect').empty().append('<option value="">-- Select Subdistrict --</option>');

                if (provinceId) {
                    $.getJSON('@Url.Action("GetDistricts", "Account")', { provinceId: provinceId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#providerDistrictSelect').append($('<option>').text(item.name).val(item.id));
                        });
                    });
                }
            });

            $('#providerDistrictSelect').change(function () {
                var districtId = $(this).val();
                $('#providerSubdistrictSelect').empty().append('<option value="">-- Select Subdistrict --</option>');

                if (districtId) {
                    $.getJSON('@Url.Action("GetSubdistricts", "Account")', { districtId: districtId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#providerSubdistrictSelect').append($('<option>').text(item.name).val(item.id));
                        });
                    });
                }
            });

            // Category Modal Scripts
            $('#categorySearchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#categoryList .category-item').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            $('#saveCategoriesBtn').click(function() {
                var selectedIds = [];
                var selectedNames = [];
                
                $('.category-checkbox:checked').each(function() {
                    selectedIds.push($(this).val());
                    selectedNames.push($(this).data('name'));
                });

                // Update display
                var displayHtml = '';
                selectedNames.forEach(function(name) {
                    displayHtml += '<span class="badge bg-info text-dark me-1">' + name + '</span>';
                });
                $('#selectedCategoriesDisplay').html(displayHtml);

                // Update hidden inputs
                var inputsHtml = '';
                selectedIds.forEach(function(id) {
                    inputsHtml += '<input type="hidden" name="ProviderCategoryIds" value="' + id + '" />';
                });
                $('#hiddenCategoryInputs').html(inputsHtml);

                // Close modal
                $('#categoryModal').modal('hide');
            });
        });
    </script>
}
