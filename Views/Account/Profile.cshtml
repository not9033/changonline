@model ChangOnline.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">My Profile</h3>
                </div>
                <div class="card-body">
                    <!-- Profile Image Section -->
                    <div class="text-center mb-4">
                        <h5 class="mb-3">รูปโปรไฟล์ส่วนตัว</h5>
                        @{
                            var userImage = !string.IsNullOrEmpty(Model.ImagePath)
                                ? Model.ImagePath
                                : "/image/man.png";
                        }
                        <img id="userProfileImage" src="@userImage" alt="User Profile"
                             style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #dee2e6;">
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#userImageModal">
                                <i class="bi bi-camera"></i> เปลี่ยนรูปส่วนตัว
                            </button>
                        </div>
                    </div>

                    

                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Username:</div>
                        <div class="col-sm-9">@Model.UserName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Email:</div>
                        <div class="col-sm-9">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">First Name:</div>
                        <div class="col-sm-9">@Model.FirstName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Last Name:</div>
                        <div class="col-sm-9">@Model.LastName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Phone:</div>
                        <div class="col-sm-9">@Model.Phone</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Address:</div>
                        <div class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.SubdistrictName))
                            {
                                <span>@Model.SubdistrictName, </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.DistrictName))
                            {
                                <span>@Model.DistrictName, </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.ProvinceName))
                            {
                                <span>@Model.ProvinceName</span>
                            }
                        </div>
                    </div>

                    @if (Model.IsProvider)
                    {
                            <hr>
                        <div class="text-center mb-4 pb-4 border-bottom">
                                <h5 class="mb-3">รูปโปรไฟล์ช่าง</h5>
                                @{
                                    var providerImage = !string.IsNullOrEmpty(Model.ProviderImagePath)
                                        ? Model.ProviderImagePath
                                        : "/image/man.png";
                                }
                                <img id="providerProfileImage" src="@providerImage" alt="Provider Profile"
                                     style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #dee2e6;">
                                <div class="mt-2">
                                    <a href="@Url.Action("Register", "Provider")" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-pencil"></i> แก้ไขโปรไฟล์ช่าง
                                    </a>
                                </div>
                            </div>
                        <h4 class="mb-3 text-primary">Provider Profile</h4>
                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold">Service:</div>
                            <div class="col-sm-9">@Model.ProviderService</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold">Categories:</div>
                            <div class="col-sm-9">
                                @if (Model.ProviderCategoryNames != null && Model.ProviderCategoryNames.Any())
                                {
                                    <ul>
                                        @foreach (var categoryName in Model.ProviderCategoryNames)
                                        {
                                            <li>@categoryName</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold">Shop Address:</div>
                            <div class="col-sm-9">
                                @if (!string.IsNullOrEmpty(Model.ProviderAddress))
                                {
                                    <div>@Model.ProviderAddress</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.ProviderSubdistrictName))
                                {
                                    <span>@Model.ProviderSubdistrictName, </span>
                                }
                                @if (!string.IsNullOrEmpty(Model.ProviderDistrictName))
                                {
                                    <span>@Model.ProviderDistrictName, </span>
                                }
                                @if (!string.IsNullOrEmpty(Model.ProviderProvinceName))
                                {
                                    <span>@Model.ProviderProvinceName</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="EditProfile" class="btn btn-warning">Edit Profile</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- User Image Upload Modal -->
<div class="modal fade" id="userImageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">เปลี่ยนรูปโปรไฟล์ส่วนตัว</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="file" id="userImageInput" accept="image/*" class="form-control mb-3">
                <img id="userImagePreview" src="@userImage" style="width: 100%; max-height: 300px; object-fit: contain;" class="mb-3">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="deleteUserImage()">ลบรูป</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary" onclick="uploadUserImage()">บันทึก</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script>
    document.getElementById('userImageInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('userImagePreview').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    });

    function uploadUserImage() {
        const fileInput = document.getElementById('userImageInput');
        if (!fileInput.files[0]) {
            alert('กรุณาเลือกรูปภาพ');
            return;
        }

        const formData = new FormData();
        formData.append('profileImage', fileInput.files[0]);

        fetch('@Url.Action("UploadProfileImage", "Account")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('userProfileImage').src = data.imagePath;
                bootstrap.Modal.getInstance(document.getElementById('userImageModal')).hide();
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            alert('เกิดข้อผิดพลาด');
            console.error(error);
        });
    }

    function deleteUserImage() {
        if (!confirm('คุณต้องการลบรูปโปรไฟล์หรือไม่?')) return;

        fetch('@Url.Action("DeleteProfileImage", "Account")', {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            alert('เกิดข้อผิดพลาด');
            console.error(error);
        });
    }
</script>
