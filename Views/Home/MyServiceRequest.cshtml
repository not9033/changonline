@model IEnumerable<ChangOnline.Models.ServiceRequest>

@{
    ViewData["Title"] = "การเรียกใช้บริการของฉัน";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>

<style>
    body {
        background-color: #f2f2f2;
        font-family: "Segoe UI", sans-serif;

        /* ทำให้ footer อยู่ล่าง */
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .main-card {
        background: white;
        padding: 25px;
        margin: 40px;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);

        /* ดันให้เต็มหน้าจอ */
        flex: 1;
    }

    .section-title {
        background: #eef2f7;
        padding: 15px 25px;
        font-size: 20px;
        font-weight: bold;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .service-box {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .profile-placeholder {
        width: 90px;
        height: 90px;
        background: #d9d9d9;
        border-radius: 5px;
        margin-right: 20px;
    }

    .btn-detail {
        border: 1px solid #b82a2c;
        color: #b82a2c;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-cancel {
        border: 1px solid #2a6db8;
        color: #2a6db8;
        border-radius: 10px;
        padding: 6px 20px;
    }

    footer {
        text-align: center;
        padding: 20px;
        color: #555;

        /* ทำให้ต่ำลงกว่าเดิม */
        margin-top: 40px;
    }

    .no-requests {
        text-align: center;
        padding: 40px;
        color: #999;
        font-size: 16px;
    }

    .status-pending { color: #ff9800; font-weight: bold; }
    .status-accepted { color: #204c9e; font-weight: bold; }
    .status-rejected { color: #f44336; font-weight: bold; }
    .status-completed { color: #4caf50; font-weight: bold; }
    .status-cancelled { color: #9e9e9e; font-weight: bold; }
</style>


<div class="main-card">

    <div class="section-title">การเรียกใช้บริการของฉัน</div>

    @if (Model != null && Model.Any())
    {
        @foreach (var request in Model)
        {
            var statusText = request.Status switch
            {
                ChangOnline.Models.ServiceRequestStatus.Pending => "รอการตอบรับ",
                ChangOnline.Models.ServiceRequestStatus.Accepted => "ได้รับการตอบรับ",
                ChangOnline.Models.ServiceRequestStatus.Rejected => "ถูกปฏิเสธ",
                ChangOnline.Models.ServiceRequestStatus.Completed => "เสร็จสิ้น",
                ChangOnline.Models.ServiceRequestStatus.Cancelled => "ยกเลิกแล้ว",
                _ => "ไม่ทราบสถานะ"
            };

            var statusClass = request.Status switch
            {
                ChangOnline.Models.ServiceRequestStatus.Pending => "status-pending",
                ChangOnline.Models.ServiceRequestStatus.Accepted => "status-accepted",
                ChangOnline.Models.ServiceRequestStatus.Rejected => "status-rejected",
                ChangOnline.Models.ServiceRequestStatus.Completed => "status-completed",
                ChangOnline.Models.ServiceRequestStatus.Cancelled => "status-cancelled",
                _ => ""
            };

            <div class="service-box">

                <div class="profile-placeholder"></div>

                <div class="service-info col-8">
                    <p>
                        <strong>@(request.Provider?.User?.FirstName ?? "ไม่ระบุ") @(request.Provider?.User?.LastName ?? "")</strong>
                    </p>
                    <p>เบอร์โทร : @(request.Provider?.User?.PhoneNumber ?? "ไม่ระบุ")</p>
                    <p>วันนัดหมาย : @request.AppointmentDate.ToString("dd/MM/yyyy ")</p>
                    @* HH:mm *@
                    <p>สถานะ : <span class="@statusClass">@statusText</span></p>
                </div>

                <div class="text-end col">
                    <button class="btn btn-detail" onclick="showDetails(@request.Id)">รายละเอียด</button><br/>
                    @if (request.Status == ChangOnline.Models.ServiceRequestStatus.Pending ||
                         request.Status == ChangOnline.Models.ServiceRequestStatus.Accepted)
                    {
                        <button class="btn btn-cancel" onclick="cancelRequest(@request.Id)">ยกเลิก</button>
                    }
                </div>

            </div>
        }
    }
    else
    {
        <div class="no-requests">
            <p>ยังไม่มีการเรียกใช้บริการ</p>
        </div>
    }

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function showDetails(requestId) {
        // TODO: Implement detail modal
        alert('รายละเอียดของคำขอ ID: ' + requestId);
    }

    function cancelRequest(requestId) {
        if (confirm('คุณต้องการยกเลิกคำขอนี้หรือไม่?')) {
            // TODO: Implement cancel functionality
            alert('ยกเลิกคำขอ ID: ' + requestId);
        }
    }
</script>