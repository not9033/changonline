@{
    ViewData["Title"] = "การเรียกใช้บริการของฉัน";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>

<style>
    body {
        background-color: #f2f2f2;
        font-family: "Segoe UI", sans-serif;

        /* ทำให้ footer อยู่ล่าง */
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .main-card {
        background: white;
        padding: 25px;
        margin: 40px;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);

        /* ดันให้เต็มหน้าจอ */
        flex: 1;
    }

    .section-title {
        background: #eef2f7;
        padding: 15px 25px;
        font-size: 20px;
        font-weight: bold;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .service-box {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
    }

    .profile-placeholder {
        width: 90px;
        height: 90px;
        background: #d9d9d9;
        border-radius: 5px;
        margin-right: 20px;
    }

    .btn-detail {
        border: 1px solid #b82a2c;
        color: #b82a2c;
        border-radius: 10px;
        padding: 6px 16px;
        margin-bottom: 8px;
    }

    .btn-cancel {
        border: 1px solid #2a6db8;
        color: #2a6db8;
        border-radius: 10px;
        padding: 6px 20px;
    }

    footer {
        text-align: center;
        padding: 20px;
        color: #555;

        /* ทำให้ต่ำลงกว่าเดิม */
        margin-top: 40px;
    }
</style>


<div class="main-card">

    <div class="section-title">การเรียกใช้บริการของฉัน</div>

    <div class="service-box">

        <div class="profile-placeholder"></div>

        <div class="service-info col-8">
            <p>
                <strong>นาย สมชาย ใจดี</strong>
            </p>
            <p>เบอร์โทร : 013 - 113 - 1130</p>
            <p>สถานะ : <span style="color:#204c9e; font-weight:bold;">กำลังเดินทาง</span></p>
        </div>

        <div class="text-end col">
            <button class="btn btn-detail" data-bs-toggle="modal" data-bs-target="#detailModal">รายละเอียด</button><br/>
            <button class="btn btn-cancel">ยกเลิก</button>
        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>