@{
    ViewData["Title"] = "All Provider";
}

<div class="all-provider-container">
    <div class="all-provider-header" style="margin-top: 26px;">
        <div class="all-provider-title">
            <p>ช่างทั้งหมด</p>
        </div>
        <div class="search-group">
            <input type="text" placeholder="ค้นหาช่างที่นี่">
            <button type="submit">ค้นหา</button>
            <div class="filter">
                <button type="submit">ตัวกรอง</button>
            </div>
            <div class="sort">
                <button type="submit">เรียง</button>
            </div>
        </div>
    </div>
    <div class="all-provider-list">
        <div class="provider-card">
            <div class="provider-card-info">
                <img src="~/image/man.png" alt="">
                <div class="provider-card-info-text">
                    <p class="provider-card-name">นายสมชาย ใจดี</p>
                    <p class="provider-card-category">ช่างก่อสร้าง</p>
                </div>
            </div>
            <div class="provider-card-button">
                <button type="submit" class="detail-btn">รายละเอียด</button>
                <button type="submit" class="request-btn">ขอใช้บริการ</button>
