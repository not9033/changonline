@model ChangOnline.Models.ViewModels.AllProviderViewModel
@{
    ViewData["Title"] = "Home Page";
}

<style>

</style>

<div class="banner">
    <div class="banner-item">
        <div class="banner-text">
            <p style="font-size: 70px">มีทุกช่าง ครบจบที่นี่</p>
            <p style="font-size: 40px">ถามหาช่างถามหาเรา</p>
        </div>
        @* asp-controller="Home" asp-action="search" *@
        <form method="get" action="@Url.Action("Index", "AllProvider")">
            <div class="search-container">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="ค้นหาช่างที่นี่" class="search-box">
                <button type="submit" class="btn-search">ค้นหา</button>
            </div>
        </form>
    </div>
</div>

<div class="category-container">
    <div class="category-main">
        <!-- หมวดหลัก -->
        <div class="category-item" data-subcategories='["เทพื้นคอนกรีต","งานเข็มเจาะ","งานเปลี่ยนโครงหลังคา","งานโครงสร้างคอนกรีตเสริมเหล็ก","งานก่ออิฐแดง","งานก่ออิฐมวลเบา","งานฉาบผนัง","งานซ่อมรอยแตกร้าว"]'>
            <img src="~/image/man.png" alt="">
            <a href="javascript:void(0)" class="main-category">ช่างก่อสร้าง</a>
        </div>

        <div class="category-item" data-subcategories='[
            "เดินไฟภายนอกบ้าน",
            "เดินไฟร้านค้า",
            "แก้ไฟช๊อต",
            "แก้ไฟตก/ไฟกระชาก",
            "ตรวจสอบระบบไฟฟ้า",
            "ติดตั้ง USP",
            "ติดตั้งแผงเบรกเกอร์",
            "ติดตั้งปลั๊กไฟ"
        ]'>
            <img src="~/image/man.png" alt="">
            <a href="javascript:void(0)" class="main-category">ช่างไฟฟ้า</a>
        </div>

        <div class="category-item" data-subcategories='["ซ่อมเครื่องจักรโรงงาน","ติดตั้งเครื่องกล","งานบำรุงรักษาเครื่องกล","งานนิวเมติก","งานไฮดรอลิก","ติดตั้งท่อลม","ระบบ HVAC","ซ่อมปั๊มลม"]'>
            <img src="~/image/man.png" alt="">
            <a href="javascript:void(0)" class="main-category">ช่างเครื่องกล</a>
        </div>

        <div class="category-item" data-subcategories='["เดินท่อ HDPE","เดินท่อ PVC","แก้ท่อตัน","ซ่อมท่อน้ำรั่ว","ติดตั้งแทงก์น้ำ","ติดตั้งปั้มน้ำ","ติดตั้งสุขภัณฑ์","ระบบน้ำร้อน-เย็น"]'>
            <img src="~/image/man.png" alt="">
            <a href="javascript:void(0)" class="main-category">ช่างปะปา</a>
        </div>

        <div class="category-item" data-subcategories='["เจาะผนังติดตั้งของ","ซ่อมเครื่องซักผ้า","ซ่อมเฟอร์นิเจอร์","ซ่อมไมโครเวฟ","ซ่อมตู้เย็น","ซ่อมทีวี","ซ่อมประตู","ติดตั้ง CCTV"]'>
            <img src="~/image/man.png" alt="">
            <a href="javascript:void(0)" class="main-category">ช่างบริการซ่อมทั่วไป</a>
        </div>

        <div class="category-item" data-subcategories='["เชื่อม CO2","เชื่อม MGI","เชื่อม TIG","เชื่อมเหล็กทั่วไป","เชื่อมสแตนเลส","งานดัดพลาสมา","งานประกอบโลหะ","ทำรั้วเหล็ก"]'>
            <img src="~/image/man.png" alt="">
            <a href="javascript:void(0)" class="main-category">ช่างเชื่อมโลหะ</a>
        </div>
    </div>

    <ul class="category-list">
        <li class="category-sub-item">เลือกหมวดหลักเพื่อดูหมวดย่อย</li>
    </ul>
</div>

<div class="comment-section">
    <div class="section-header">
        <p>ความคิดเห็นจากผู้ใช้บริการ</p>
    </div>

    <div class="comment-container">
        <div class="comment-card">
            <div class="star">
                <i class="fa-solid fa-star" style="color: #74C0FC;"></i>
                <i class="fa-solid fa-star" style="color: #74C0FC;"></i>
                <i class="fa-solid fa-star" style="color: #74C0FC;"></i>
                <i class="fa-solid fa-star" style="color: #74C0FC;"></i>
                <i class="fa-solid fa-star" style="color: #74C0FC;"></i>
            </div>
            <p class="comment-text">ช่างมาตรงเวลา งานเรียบร้อยดีครับ</p>
            <div class="horizontal-line"></div>
            <div class="comment-user-info">
                <img src="~/image/man.png" alt="">
                <p class="comment-user">นายสมชาย ใจดี</p>
            </div>
        </div>
    </div>
</div>

<script>
// JS สำหรับหมวดย่อยไดนามิก
document.addEventListener("DOMContentLoaded", function() {
    const mainCategories = document.querySelectorAll(".main-category");
    const categoryList = document.querySelector(".category-list");

    mainCategories.forEach(cat => {
        cat.addEventListener("click", function() {
            const parent = cat.closest(".category-item");
            const subs = JSON.parse(parent.dataset.subcategories);

            categoryList.innerHTML = ""; // ล้าง list เดิม

            subs.forEach(sub => {
                const li = document.createElement("li");
                li.className = "category-sub-item";
                li.innerHTML = `<a href="/AllProvider?category=${encodeURIComponent(sub)}">${sub}</a>`;
                categoryList.appendChild(li);
            });
        });
    });
});
</script>
